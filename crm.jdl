application {
  config {
    baseName crmApp,
    applicationType monolith,
    packageName com.ultex.crm,
    authenticationType jwt,
    prodDatabaseType postgresql,
    buildTool maven,
    clientFramework react,
    enableTranslation true,
    nativeLanguage fr,
    languages [en, fr]
  }
  entities *
}

// =========================
// NEW ENTITY: Langue
// =========================

entity Langue {
  code String required unique, // FR, EN, AR, ES...
  nom  String required         // Français, English, العربية...
}

// =========================
// NEW ENTITY: ReseauSocial
// =========================

enum PlateformeSociale {
  FACEBOOK,
  INSTAGRAM,
  WHATSAPP,
  YOUTUBE,
  X_TWITTER,
  LINKEDIN,
  TIKTOK,
  SNAPCHAT,
  TELEGRAM,
  AUTRE
}

entity ReseauSocial {
  plateforme PlateformeSociale required,
  urlProfil String,
  username String,
  type String // Pro / Personnel / Autre
}

// =========================
// ENTITIES (Original + Cleaned)
// =========================

entity Client {
  code String required pattern(/[A-Z0-9]{4,}/),
  nomComplet String required,
  photoUrl String,
  dateNaissance LocalDate,
  lieuNaissance String,
  nationalite String required,
  genre String,
  fonction String,
  telephonePrincipal String required pattern(/^\+[0-9]{8,15}$/),
  whatsapp String,
  email String,
  adressePersonnelle String,
  adressesLivraison String,
  createdAt Instant,
  updatedAt Instant
}

entity Devise {
  code String required unique,
  nomComplet String required,
  symbole String,
  pays String
}

enum TypeProduit {
  VEHICULE,
  MACHINE,
  PRODUIT_FINAL,
  MATIERE_PREMIERE,
  AUTRE
}

entity Incoterm {
  code String required unique,
  description String required
}

entity Pays {
  code String required unique,
  nom String required,
  indicatif String
}

entity History {
  entityName String required,
  entityId Long required,
  action String required,
  fieldChanged String,
  oldValue String,
  newValue String,
  performedBy String required,
  performedDate Instant required,
  details TextBlob,
  ipAddress String,
  userAgent String
}

entity SocieteLiee {
  raisonSociale String required,
  formeJuridique String,
  ice String,
  rc String,
  nif String,
  secteurActivite String,
  tailleEntreprise String,
  adresseSiege String,
  representantLegal String
}

entity ContactAssocie {
  nom String required,
  prenom String required,
  relation String,
  telephone String,
  whatsapp String,
  email String,
  autorisation String,
  remarques String
}

entity DocumentClient {
  typeDocument String required,
  numeroDocument String,
  fichierUrl String
}

entity SousService {
  code String required unique,
  libelle String required
}

entity DemandeClient {
  reference String required,
  dateDemande Instant required,
  servicePrincipal ServicePrincipal required,
  typeDemande TypeDemande required,
  provenance String,
  remarqueGenerale String
}

entity ProduitDemande {
  typeProduit TypeProduit required,
  nomProduit String required,
  description String,
  quantite Double,
  unite String,
  prix Double,
  poidsKg Double,
  volumeTotalCbm Double,
  dimensions String,
  hsCode String,
  prixCible Double,
  fraisExpedition Double,
  origine String,
  fournisseur String,
  adresseChargement String,
  adresseDechargement String,
  ficheTechniqueUrl String,
  photosUrl String,
  piecesJointesUrl String
}

entity CycleActivation {
  numeroCycle Integer required,
  dateDebut Instant required,
  dateFin Instant,
  statutCycle String,
  commentaire TextBlob
}

entity EtatInteraction {
  etat EtatCRM required,
  dateEtat Instant required,
  agent String,
  observation TextBlob
}

entity HistoriqueCRM {
  dateInteraction Instant required,
  canal String,
  agent String,
  resume TextBlob,
  etat String,
  observation String
}

entity KycClient {
  scoreStaff Integer,
  comportements String,
  remarques String,
  completudeKyc Integer,
  responsable String
}

entity Prospect {
  firstName String required,
  lastName String required,
  email String required unique,
  phone1 String,
  phone2 String,
  source String,
  cin String,
  address String,
  city String,
  country String,
  deliveryAddress String,
  referredBy String,
  status ProspectStatus required,
  convertedDate Instant,
  createdAt Instant,
  updatedAt Instant
}

entity Opportunity {
  title String required,
  description String,
  amount BigDecimal required,
  stage OpportunityStage required,
  closeDate Instant,
  createdAt Instant,
  updatedAt Instant
}

entity InternalUser {
  fullName String required,
  role UserRole required,
  email String required unique,
  phone String,
  createdAt Instant,
  updatedAt Instant
}

entity Company {
  name String required,
  address String,
  city String,
  country String,
  phone String,
  email String,
  website String,
  industry String,
  createdAt Instant,
  updatedAt Instant
}

entity RappelAgent {
  rappelDate Instant required,
  rappelMessage String,
  statutRappel StatutRappel required,
  createdAt Instant,
  updatedAt Instant
}

entity Contact {
  firstName String required,
  lastName String required,
  email String required,
  phone String,
  cin String,
  position String,
  quality String,
  createdAt Instant,
  updatedAt Instant
}

// ===============================
// ENUMS
// ===============================

enum ClientStatus {
  ACTIVE, INACTIVE, ARCHIVED
}

enum ProspectStatus {
  NEW, CONTACTED, QUALIFIED, LOST
}

enum OpportunityStage {
  LEAD, NEGOTIATION, WON, LOST
}

enum UserRole {
  ADMIN, MANAGER, COMMERCIAL
}

enum EtatCRM {
  TRAITE,
  EN_COURS,
  FAIBLE_QUALITE,
  PAS_PRET,
  PAS_INTERESSE,
  ACTIVE,
  PAS_DE_REPONSE,
  DOUBLE_CODAGE,
  NUMERO_ERRONE,
  AUTRE
}

enum TypeDemande {
  PROFORMA,
  SOURCING,
  NEGOCIATION,
  AUTRE
}

enum ServicePrincipal {
  IMPORT,
  EXPORT
}

enum StatutRappel {
  PENDING,
  DONE,
  MISSED
}

// ===============================
// RELATIONSHIPS
// ===============================

// NEW: Client prefers a language
relationship ManyToOne {
  Client{languePreferee} to Langue
}

// NEW: Client has many social networks
relationship OneToMany {
  Client{reseauxSociaux} to ReseauSocial{client required}
}

relationship ManyToMany {
  DemandeClient{sousServices} to SousService{demandes}
}

relationship OneToMany {
  Client{opportunities} to Opportunity{client required}
}

relationship ManyToOne {
  RappelAgent{etat} to EtatInteraction
}

relationship ManyToOne {
  RappelAgent{client} to Client
}

relationship ManyToOne {
  RappelAgent{agent} to InternalUser
}

relationship ManyToOne {
  ContactAssocie{client} to Client
}

relationship OneToMany {
  DemandeClient{produits} to ProduitDemande{demande}
}

relationship ManyToOne {
  HistoriqueCRM{client} to Client
}

relationship ManyToOne {
  Opportunity{assignedTo required} to InternalUser{opportunities}
}

relationship ManyToOne {
  DocumentClient{client} to Client
}

relationship ManyToOne {
  DemandeClient{client} to Client
}

relationship OneToOne {
  KycClient{client} to Client
}

relationship ManyToOne {
  DemandeClient{devise} to Devise,
  DemandeClient{incoterm} to Incoterm
}

relationship OneToMany {
  Client{cyclesActivation} to CycleActivation{client required}
}

relationship OneToMany {
  CycleActivation{etats} to EtatInteraction{cycle required}
}

relationship ManyToOne {
  EtatInteraction{historique} to HistoriqueCRM
}

relationship ManyToOne {
  Client{pays} to Pays
}

relationship OneToOne {
  Prospect{convertedTo} to Client{convertedFromProspect}
}

relationship ManyToOne {
  Prospect{convertedBy required} to InternalUser{convertedProspects}
}

relationship ManyToOne {
  Client{company} to Company{clients}
}

relationship ManyToOne {
  Prospect{company} to Company{prospects}
}

relationship ManyToOne {
  Contact{company required} to Company{contacts}
}

relationship ManyToOne {
  Contact{client} to Client{contacts}
}

relationship ManyToOne {
  Contact{prospect} to Prospect{contacts}
}

relationship ManyToOne {
  SocieteLiee{client} to Client
}

// ===============================
// OPTIONS
// ===============================

paginate * with pagination
service all with serviceClass
dto all with mapstruct
search all with elasticsearch
